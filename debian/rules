#!/usr/bin/make -f
export GOTOOLCHAIN=local
export GOPROXY=off
export GOSUMDB=off
export GOCACHE=$(CURDIR)/build/go-cache
export GOFLAGS=-buildvcs=false -buildmode=pie
export CGO_ENABLED=1
export DEB_BUILD_MAINT_OPTIONS=hardening=+all
include /usr/share/dpkg/buildflags.mk
export CGO_CFLAGS=$(CFLAGS)
export CGO_LDFLAGS=$(LDFLAGS)

%:
	dh $@ --buildsystem=makefile

override_dh_auto_build:
	$(MAKE) build VERSION=$(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//') GO_LDFLAGS="-B gobuildid -linkmode external"

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) check
endif

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/tintfetch PREFIX=/usr LICENSEDIR=/usr/share/doc/tintfetch VERSION=$(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//') GO_LDFLAGS="-B gobuildid -linkmode external"

# dwz does not support the Go compiler's compressed DWARF sections.
override_dh_dwz:
